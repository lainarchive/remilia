{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#39C5BB",
          "template": "╭─ 󰐷 "
        },
        {
          "type": "session",
          "style": "plain",
          "foreground": "#9DEFE9",
          "template": "{{ .UserName }}@{{ .HostName }}"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "#FF77A9",
          "template": "  ✦"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "path",
          "style": "plain",
          "foreground": "#B7F7F2",
          "template": "╰─  {{ .Path }} "
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#39C5BB",
          "template": " {{ .HEAD }}{{ if .Working.Changed }} ✎{{ end }} "
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "#FF77A9",
          "template": "{{ if ne .Code 0 }}✗{{ else }}{{ end }} "
        }
      ]
    }
  ]
}
