<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Themes/Base.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Remilia palette: black cherry, warm ivory, muted rose -->
    <SolidColorBrush x:Key="RemiliaBg">#09070B</SolidColorBrush>
    <SolidColorBrush x:Key="RemiliaPanel">#110C13</SolidColorBrush>
    <SolidColorBrush x:Key="RemiliaPanel2">#160F17</SolidColorBrush>
    <SolidColorBrush x:Key="RemiliaLine">#2C1823</SolidColorBrush>
    <SolidColorBrush x:Key="RemiliaLineBright">#5A2738</SolidColorBrush>
    <SolidColorBrush x:Key="RemiliaRed">#B9364D</SolidColorBrush>
    <SolidColorBrush x:Key="RemiliaPink">#F05A72</SolidColorBrush>
    <SolidColorBrush x:Key="RemiliaText">#F4E8EE</SolidColorBrush>
    <SolidColorBrush x:Key="RemiliaMuted">#9F8592</SolidColorBrush>

    <Thickness x:Key="ResultMargin">9 4 9 4</Thickness>

    <Style x:Key="ItemGlyph" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#F4E8EE" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="Opacity" Value="0.92" />
    </Style>

    <Style x:Key="QueryBoxStyle" TargetType="{x:Type TextBox}">
        <Setter Property="Foreground" Value="#F4E8EE" />
        <Setter Property="CaretBrush" Value="#F05A72" />
        <Setter Property="SelectionBrush" Value="#7AB9364D" />
        <Setter Property="Background" Value="#160F17" />
        <Setter Property="BorderBrush" Value="#5A2738" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14 2 46 2" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="QuerySuggestionBoxStyle" TargetType="{x:Type TextBox}">
        <Setter Property="Foreground" Value="#8D7480" />
    </Style>

    <Style x:Key="WindowBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#09070B" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#4A2130" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="7" />
    </Style>

    <Style x:Key="SeparatorStyle" TargetType="{x:Type Rectangle}">
        <Setter Property="Fill" Value="#321B26" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="12 1 12 5" />
    </Style>

    <Style x:Key="WindowStyle" TargetType="{x:Type Window}">
        <Setter Property="Background" Value="#09070B" />
    </Style>

    <Style x:Key="PendingLineStyle" TargetType="{x:Type Line}">
        <Setter Property="Stroke" Value="#B9364D" />
        <Setter Property="StrokeThickness" Value="2" />
    </Style>

    <Style x:Key="ItemTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#F4E8EE" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="ItemSubTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#9F8592" />
        <Setter Property="Opacity" Value="0.78" />
    </Style>

    <Style x:Key="ItemTitleSelectedStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#FFF7F9" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="ItemSubTitleSelectedStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#F3B7C2" />
    </Style>

    <SolidColorBrush x:Key="ItemSelectedBackgroundColor">#9AB9364D</SolidColorBrush>

    <Style x:Key="ThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border Background="#F05A72" BorderBrush="Transparent" BorderThickness="0" CornerRadius="2" DockPanel.Dock="Right" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBarStyle" TargetType="{x:Type ScrollBar}" />
    <Style x:Key="HorizontalScrollBarStyle" TargetType="{x:Type ScrollBar}" />

    <Style x:Key="HorizontalThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border Background="#F05A72" BorderBrush="Transparent" BorderThickness="0" CornerRadius="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Geometry x:Key="SearchIconImg">F1 M20,20z M0,0z M14.75,1A5.24,5.24,0,0,0,10,4A5.24,5.24,0,0,0,0,6.25C0,11.75 10,19 10,19 10,19 20,11.75 20,6.25A5.25,5.25,0,0,0,14.75,1z</Geometry>

    <Style x:Key="SearchIconPosition" TargetType="{x:Type Canvas}">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Margin" Value="0 6 14 0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <Style x:Key="SearchIconStyle" TargetType="{x:Type Path}">
        <Setter Property="Fill" Value="#F05A72" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
    </Style>

    <Style x:Key="ItemHotkeyStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#D46B7E" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="ItemHotkeySelectedStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#FFD7DE" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="ClockBox" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#B38F9D" />
    </Style>

    <Style x:Key="DateBox" TargetType="{x:Type TextBlock}">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#C69AAA" />
    </Style>

    <Style x:Key="PreviewBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="BorderBrush" Value="#4A2130" />
    </Style>

    <Style x:Key="PreviewItemTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#F4E8EE" />
    </Style>

    <Style x:Key="PreviewItemSubTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#9F8592" />
    </Style>

    <Style x:Key="PreviewGlyph" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#F4E8EE" />
    </Style>
</ResourceDictionary>