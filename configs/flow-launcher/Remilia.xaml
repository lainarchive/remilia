<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Themes/Base.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <!-- Remilia palette -->
    <SolidColorBrush x:Key="RemiliaBg">#0B090D</SolidColorBrush>
    <SolidColorBrush x:Key="RemiliaPanel">#120E14</SolidColorBrush>
    <SolidColorBrush x:Key="RemiliaPanelAlt">#181119</SolidColorBrush>
    <SolidColorBrush x:Key="RemiliaLine">#35202B</SolidColorBrush>
    <SolidColorBrush x:Key="RemiliaRed">#D34B58</SolidColorBrush>
    <SolidColorBrush x:Key="RemiliaPink">#FF6470</SolidColorBrush>
    <SolidColorBrush x:Key="RemiliaText">#F1E7EC</SolidColorBrush>
    <SolidColorBrush x:Key="RemiliaMuted">#A58D98</SolidColorBrush>
    <Thickness x:Key="ResultMargin">10 5 10 5</Thickness>
    <Style
        x:Key="ItemGlyph"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#E8DCE2" />
    </Style>
    <Style
        x:Key="QueryBoxStyle"
        TargetType="{x:Type TextBox}">
        <Setter Property="Foreground" Value="#F1E7EC" />
        <Setter Property="CaretBrush" Value="#FF6470" />
        <Setter Property="SelectionBrush" Value="#7AD34B58" />
        <Setter Property="Background" Value="#160F18" />
        <Setter Property="BorderBrush" Value="#6B3042" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16 4 50 4" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style
        x:Key="QuerySuggestionBoxStyle"
        TargetType="{x:Type TextBox}">
        <Setter Property="Foreground" Value="#C19EAA" />
    </Style>

    <Style
        x:Key="WindowBorderStyle"
        TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#0B090D" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#7A3549" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="10" />
    </Style>
    <Style
        x:Key="SeparatorStyle"
        TargetType="{x:Type Rectangle}">
        <Setter Property="Fill" Value="#6B3042" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="10 2 10 6" />
        <Setter Property="Opacity" Value="0.9" />
    </Style>
    <Style
        x:Key="WindowStyle"
        TargetType="{x:Type Window}">
        <Setter Property="Background" Value="#0B090D" />
        <Setter Property="AllowsTransparency" Value="True" />
    </Style>
    <Style
        x:Key="PendingLineStyle"
        TargetType="{x:Type Line}">
        <Setter Property="Stroke" Value="#FF6470" />
    </Style>
    <Style
        x:Key="ItemTitleStyle"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#F1E7EC" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style
        x:Key="ItemSubTitleStyle"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#A58D98" />
        <Setter Property="Opacity" Value="0.78" />
    </Style>
    <Style
        x:Key="ItemTitleSelectedStyle"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#FFF4F6" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style
        x:Key="ItemSubTitleSelectedStyle"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#FFD0D5" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <SolidColorBrush x:Key="ItemSelectedBackgroundColor">#9A4A2535</SolidColorBrush>
    <Style
        x:Key="ThumbStyle"
        TargetType="{x:Type Thumb}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border
                        Background="#FF6470"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        CornerRadius="2"
                        DockPanel.Dock="Right" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style
        x:Key="ScrollBarStyle"
        TargetType="{x:Type ScrollBar}" />
    <Style
        x:Key="HorizontalScrollBarStyle"
        TargetType="{x:Type ScrollBar}" />
    <Style
        x:Key="HorizontalThumbStyle"
        TargetType="{x:Type Thumb}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border
                        Background="#FF6470"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        CornerRadius="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Geometry x:Key="SearchIconImg">M 9 1 A 8 8 0 1 0 9 17 A 8 8 0 1 0 9 1 M 15 15 L 22 22</Geometry>

    <Style x:Key="SearchIconPosition" TargetType="{x:Type Canvas}">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Margin" Value="0 6 14 0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style x:Key="SearchIconStyle" TargetType="{x:Type Path}">
        <Setter Property="Fill" Value="#FF6470" />
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Opacity" Value="0.95" />
    </Style>
    <Style
        x:Key="ItemHotkeyStyle"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#FF9AA3" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style
        x:Key="ItemHotkeySelectedStyle"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#FFD0D5" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style
        x:Key="ClockBox"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#C19EAA" />
    </Style>
    <Style
        x:Key="DateBox"
        TargetType="{x:Type TextBlock}">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#8D727D" />
    </Style>
    <Style
        x:Key="PreviewBorderStyle"
        TargetType="{x:Type Border}">
        <Setter Property="BorderBrush" Value="#5A2C3A" />
    </Style>
    <Style
        x:Key="PreviewItemTitleStyle"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#E8DCE2" />
    </Style>
    <Style
        x:Key="PreviewItemSubTitleStyle"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#A58D98" />
    </Style>
    <Style
        x:Key="PreviewGlyph"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#E8DCE2" />
    </Style>
</ResourceDictionary>