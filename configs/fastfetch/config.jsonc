{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "file",
    "source": "%USERPROFILE%/remilia/configs/fastfetch/scarlet.txt",
    "padding": {
      "top": 1,
      "left": 1,
      "right": 5
    },
    "printRemaining": false,
    "color": {
      "1": "#C05A78",
      "2": "#F1E8EA",
      "3": "#8D2E4B",
      "4": "#4A1D2B"
    }
  },

  "display": {
    "pipe": false,
    "separator": "  ",
    "color": {
      "keys": "#C05A78",
      "title": "#F1E8EA",
      "output": "#E8DEDF",
      "separator": "#4A1D2B"
    },
    "key": {
      "width": 12
    },
    "bar": {
      "width": 10,
      "char": {
        "elapsed": "━",
        "total": "─"
      },
      "border": {
        "left": "⟦",
        "right": "⟧"
      },
      "color": {
        "elapsed": "#9A3B59",
        "total": "#351722",
        "border": "#6F263F"
      }
    },
    "percent": {
      "type": ["num"],
      "color": {
        "green": "#BFA0AD",
        "yellow": "#D7B07B",
        "red": "#C05A78"
      }
    },
    "temp": {
      "green": 60,
      "yellow": 80,
      "color": {
        "green": "#BFA0AD",
        "yellow": "#D7B07B",
        "red": "#C05A78"
      }
    }
  },

  "modules": [
    {
      "type": "title",
      "key": " ",
      "format": "{##F1E8EA}{user-name}{##9A3B59}@{##F1E8EA}{host-name}{#}"
    },

    {
      "type": "custom",
      "format": "{##4A1D2B}╭─────────────── {##C05A78}SYSTEM {##4A1D2B}───────────────╮{#}"
    },
    {
      "type": "os",
      "key": "OS",
      "keyColor": "#C05A78",
      "format": "{pretty-name} [{arch}]"
    },
    {
      "type": "wm",
      "key": "WM",
      "keyColor": "#C05A78",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "shell",
      "key": "SHELL",
      "keyColor": "#C05A78",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "terminal",
      "key": "TERM",
      "keyColor": "#C05A78",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "custom",
      "format": "{##4A1D2B}╰────────────────────────────────────╯{#}"
    },

    "break",

    {
      "type": "custom",
      "format": "{##4A1D2B}╭────────────── {##C05A78}HARDWARE {##4A1D2B}──────────────╮{#}"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "keyColor": "#C05A78",
      "temp": true,
      "format": "{name} • {cores-physical}C/{cores-logical}T{?temperature} • {temperature}{?}"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "keyColor": "#C05A78",
      "temp": true,
      "format": "{name}{?temperature} • {temperature}{?}"
    },
    {
      "type": "memory",
      "key": "RAM",
      "keyColor": "#C05A78",
      "format": "{used} / {total}  {percentage-bar} {percentage}",
      "percent": {
        "type": ["bar", "num"]
      }
    },
    {
      "type": "disk",
      "key": "DISK",
      "keyColor": "#C05A78",
      "format": "{mountpoint} • {size-used} / {size-total}  {size-percentage-bar} {size-percentage}",
      "percent": {
        "type": ["bar", "num"]
      }
    },
    {
      "type": "display",
      "key": "DISPLAY",
      "keyColor": "#C05A78",
      "format": "{width}x{height} @ {refresh-rate}Hz"
    },
    {
      "type": "custom",
      "format": "{##4A1D2B}╰────────────────────────────────────╯{#}"
    },

    "break",

    {
      "type": "custom",
      "format": "{##4A1D2B}╭────────────── {##C05A78}SESSION {##4A1D2B}──────────────╮{#}"
    },
    {
      "type": "uptime",
      "key": "UP",
      "keyColor": "#C05A78",
      "format": "{formatted}"
    },
    {
      "type": "datetime",
      "key": "DATE",
      "keyColor": "#C05A78",
      "format": "{year}-{month-pretty}-{day-pretty} {hour-pretty}:{minute-pretty}"
    },
    {
      "type": "sound",
      "key": "AUDIO",
      "keyColor": "#C05A78",
      "format": "{name}"
    },
    {
      "type": "localip",
      "key": "LAN",
      "keyColor": "#C05A78",
      "format": "{ipv4} • {ifname}",
      "showIpv4": true,
      "showIpv6": false,
      "showLoop": false
    },
    {
      "type": "custom",
      "format": "{##4A1D2B}╰────────────────────────────────────╯{#}"
    }
  ]
}
